import cv2
from ultralytics import YOLO

# Load YOLOv8 model (weights file can be adjusted based on the model version you want)
model = YOLO("yolov8n.pt")  # You can use yolov8s.pt, yolov8m.pt, etc., depending on the variant

# Open the webcam
cap = cv2.VideoCapture(2)

# Check if the webcam is opened correctly
if not cap.isOpened():
    print("Error: Could not open webcam.")
    exit()
 
# Create a named window and set the window to be resizable
cv2.namedWindow('YOLOv8 Object Detection', cv2.WINDOW_NORMAL)
cv2.resizeWindow('YOLOv8 Object Detection', 1920, 1080)  # Resize the window to 1920x1080 (Full HD)

while True:
    # Read a frame from the webcam
    ret, frame = cap.read()
    if not ret:
        print("Error: Failed to capture image.")
        break

    # Perform object detection on the frame
    results = model(frame)

    # Render results on the frame
    frame_with_boxes = results[0].plot()  # Draws bounding boxes on the frame (updated for YOLOv8)

    # Resize the frame to make it bigger (for example, 1920x1080)
    frame_resized = cv2.resize(frame_with_boxes, (1920, 1080))  # Resize to Full HD (1920x1080)

    # Display the resulting frame
    cv2.imshow('YOLOv8 Object Detection', frame_resized)

    # Break loop on 'q' key press
    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

# Release the webcam and close OpenCV windows
cap.release()
cv2.destroyAllWindows()
